<Window x:Class="ProjektWPF.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Statystyki zadań" Height="500" Width="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Statystyki zadań" FontSize="24" FontWeight="Bold" Margin="0 0 0 20" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Zadania wg statusu -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Ukończone vs Nieukończone" FontWeight="Bold" FontSize="16" Margin="0 0 0 10" />
                <lvc:PieChart Series="{Binding CompletionSeries}" LegendPosition="Bottom" Height="300" />
            </StackPanel>

            <!-- Zadania wg kategorii -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Zadania wg kategorii" FontWeight="Bold" FontSize="16" Margin="0 0 0 10" />
                <lvc:PieChart Series="{Binding CategorySeries}" LegendPosition="Bottom" Height="300" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

