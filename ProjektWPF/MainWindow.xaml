<Window x:Class="ProjektWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ProjektWPF.Controls"
        xmlns:local="clr-namespace:ProjektWPF"
        mc:Ignorable="d"
        Title="Lista zadań" Height="600" Width="1000" MinWidth="600" MinHeight="400"
        Icon="favicon.ico">
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <!-- Słowniki motywów -->
            <ResourceDictionary x:Key="LightTheme">
                <SolidColorBrush x:Key="WindowBackgroundBrush" Color="White"/>
                <SolidColorBrush x:Key="TextBrush" Color="Black"/>
                <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="NavajoWhite"/>
                <SolidColorBrush x:Key="ButtonHoverBrush" Color="DarkSalmon"/>
                <SolidColorBrush x:Key="BorderBrush" Color="#DDDDDD"/>
                <SolidColorBrush x:Key="ToolBarBackgroundBrush" Color="#F0F0F0"/>
                <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#F0F0F0"/>
                <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FAFAFA"/>
                <SolidColorBrush x:Key="LowPriorityBrush" Color="#E8F5E9"/>
                <SolidColorBrush x:Key="MediumPriorityBrush" Color="#FFF9C4"/>
                <SolidColorBrush x:Key="HighPriorityBrush" Color="#FFCDD2"/>
            </ResourceDictionary>

            <ResourceDictionary x:Key="DarkTheme">
                <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#2D2D30"/>
                <SolidColorBrush x:Key="TextBrush" Color="White"/>
                <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#404040"/>
                <SolidColorBrush x:Key="ButtonHoverBrush" Color="#505050"/>
                <SolidColorBrush x:Key="BorderBrush" Color="#404040"/>
                <SolidColorBrush x:Key="ToolBarBackgroundBrush" Color="#3C3C3C"/>
                <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#3C3C3C"/>
                <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#252526"/>
                <SolidColorBrush x:Key="LowPriorityBrush" Color="#2E4A2E"/>
                <SolidColorBrush x:Key="MediumPriorityBrush" Color="#4A4A2E"/>
                <SolidColorBrush x:Key="HighPriorityBrush" Color="#4A2E2E"/>
            </ResourceDictionary>

            <!-- Domyślne kolory (jasny motyw) -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="White"/>
            <SolidColorBrush x:Key="TextBrush" Color="Black"/>
            <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="NavajoWhite"/>
            <SolidColorBrush x:Key="ButtonHoverBrush" Color="DarkSalmon"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#DDDDDD"/>
            <SolidColorBrush x:Key="ToolBarBackgroundBrush" Color="#F0F0F0"/>
            <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#F0F0F0"/>
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FAFAFA"/>

            <SolidColorBrush x:Key="LowPriorityBrush" Color="#E8F5E9"/>
            <SolidColorBrush x:Key="MediumPriorityBrush" Color="#FFF9C4"/>
            <SolidColorBrush x:Key="HighPriorityBrush" Color="#FFCDD2"/>

            <!-- Style dla kontrolek -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="10,5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            </Style>

            <Style TargetType="ListBox">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>

            <Style TargetType="ToolBar">
                <Setter Property="Background" Value="{DynamicResource ToolBarBackgroundBrush}"/>
            </Style>

            <Style TargetType="StatusBar">
                <Setter Property="Background" Value="{DynamicResource StatusBarBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>

            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Style>

            <!-- Zaktualizowane kolorowanie tła według priorytetu z obsługą ciemnego motywu -->
            <Style x:Key="TaskBorderStyle" TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Priority}" Value="Niski">
                        <Setter Property="Background" Value="{DynamicResource LowPriorityBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Priority}" Value="Średni">
                        <Setter Property="Background" Value="{DynamicResource MediumPriorityBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Priority}" Value="Wysoki">
                        <Setter Property="Background" Value="{DynamicResource HighPriorityBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True" Background="{DynamicResource WindowBackgroundBrush}">

        <!-- Pasek narzędzi -->
        <ToolBar DockPanel.Dock="Top" Height="62">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding AddTaskCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" Margin="0,0,5,0"/>
                        <TextBlock Text="Dodaj zadanie"/>
                    </StackPanel>
                </Button>
                <Button Width="100" Click="ShowStatistics_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" Margin="0,0,5,0"/>
                        <TextBlock Text="Statystyki"/>
                    </StackPanel>
                </Button>
                <Button Padding="8" Click="FetchZenQuote_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💬" Margin="0,0,5,0"/>
                        <TextBlock Text="Cytat"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ToggleThemeCommand}" Width="120">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ThemeIcon}" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding ThemeText}"/>
                    </StackPanel>
                </Button>
                <TextBox Width="200" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </ToolBar>

        <!-- Pasek stanu -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding TaskSummary}" />
        </StatusBar>

        <Grid Background="{DynamicResource WindowBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: Kategorie -->
            <StackPanel Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
                <Button Content="Kategorie" FontWeight="Bold" FontSize="14" Command="{Binding AddCategoryCommand}" Margin="5 10 5 5"/>
                <ListBox ItemsSource="{Binding Categories}" FontWeight="SemiBold" FontSize="12"
                         SelectedItem="{Binding SelectedCategory}"
                         DisplayMemberPath="Name" />

                <controls:FilterControl DataContext="{Binding FilterViewModel}" />

            </StackPanel>

            <!-- Lista zadań -->
            <ScrollViewer Grid.Column="1" Margin="10" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Header="{Binding Name}" IsExpanded="False" Margin="0 5 0 0">
                                <Border Style="{StaticResource TaskBorderStyle}" Padding="10" CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Description}" FontStyle="Italic" FontSize="13" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                            <WrapPanel>
                                                <TextBlock Text="Kategoria: " FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Category.Name}" Margin="5,0"/>
                                                <TextBlock Text=" | Pilność: " FontWeight="Bold" Margin="10,0"/>
                                                <TextBlock Text="{Binding Priority}" />
                                                <TextBlock Text=" | Termin: " FontWeight="Bold" Margin="10,0"/>
                                                <TextBlock Text="{Binding DueDate}" />
                                            </WrapPanel>
                                            <ItemsControl ItemsSource="{Binding SubTasks}" Margin="0,5,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                                            <CheckBox IsChecked="{Binding IsDone}" Margin="0,0,5,0"/>
                                                            <TextBlock Text="{Binding Name}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Przyciski -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Width="80" Margin="5 0"
                                                    Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="✏️" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Edytuj"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Width="80" Margin="5 0"
                                                    Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🗑️" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Usuń"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>